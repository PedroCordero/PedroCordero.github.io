---
// Round organisation logo. Drop a file named after the organisation into content/cv/logos/
// (e.g. "European Knowledge Center" -> european-knowledge-center.png); otherwise its initials show.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { initials, slugify } from '@/lib/utils';

interface Props {
  name: string;
}

const { name } = Astro.props;
const logos = import.meta.glob<{ default: ImageMetadata }>('/content/cv/logos/*.{png,jpg,jpeg,webp}', { eager: true });
const logo = Object.entries(logos).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === slugify(name));
const base = 'size-8 md:size-10 p-1 border rounded-full shadow ring-2 ring-border flex-none';
---

{logo
  ? <Image src={logo[1].default} alt="" width={80} class={`${base} object-contain bg-white`} />
  : <div class={`${base} bg-muted flex items-center justify-center text-[9px] md:text-[11px] font-semibold text-muted-foreground`} aria-hidden="true">{initials(name)}</div>}
