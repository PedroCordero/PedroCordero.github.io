---
import { getCollection } from 'astro:content';
import cv from '../data/cv.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = cv.roles[0]?.headline ?? '' } = Astro.props;
const name = cv.person.name;
const pages = (await getCollection('pages', ({ id }) => id !== 'home'))
  .sort((a, b) => a.data.order - b.data.order);
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/cv/', label: 'CV' },
  ...pages.map((p) => ({ href: `/${p.id}/`, label: p.data.title })),
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${name}` : name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">{name}</a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <a href={`mailto:${cv.person.email}`}>{cv.person.email}</a>
        {cv.person.links.map((link) => <a href={`https://${link}`}>{link}</a>)}
      </div>
    </footer>
  </body>
</html>
