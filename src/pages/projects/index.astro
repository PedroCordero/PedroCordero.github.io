---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

// Featured projects first, then newest first.
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Projects" description="All projects">
  <h1>Projects</h1>
  <div class="grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
</Base>
